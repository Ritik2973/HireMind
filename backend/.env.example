# Database connection settings
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# Replace YOUR_PASSWORD_HERE with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/hiremind

# JWT Authentication
JWT_SECRET_KEY=your_secure_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# SQLAlchemy Engine Query Logging (false in production)
SQL_ECHO=false
